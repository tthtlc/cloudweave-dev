# Vault standalone project — environment overrides.
# Copy to .env and adjust as needed. setup.sh creates the shared libcloud_net
# network, sources ../openfga_my/.env (seed credentials), and runs
# vault-bootstrap with those vars exported — so this file only needs the port.

# Host port published for Vault's HTTP API.
VAULT_PORT=8200

# Public address written into generated/vault.env (used by host-side tools).
VAULT_PUBLIC_ADDR=http://localhost:8200

# Cloud backend credentials seeded into Vault as KV v2 secrets. These are
# normally provided by ../openfga_my/.env via setup.sh; define them here only
# if you run `docker compose up vault-bootstrap` directly from this directory.
# LIBCLOUD_AWS_PROD_KEY=
# LIBCLOUD_AWS_PROD_SECRET=
# LIBCLOUD_NTNX_LAB_USER=
# LIBCLOUD_NTNX_LAB_PASSWORD=
