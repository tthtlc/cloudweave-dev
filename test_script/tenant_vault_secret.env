# Per-tenant backend cloud credentials.
#
# Each company maps to its own AWS tenant (all under the AWS provider), so each
# tenant stores its own access key / secret at secret/data/libcloud/<tenant>.
#
#   tenant "aws"     -> AWS_ACCESS_KEY  / AWS_SECRET_ACCESS_KEY
#   tenant "aws1"    -> AWS1_ACCESS_KEY / AWS1_SECRET_KEY
#   tenant "aws2"    -> AWS2_ACCESS_KEY / AWS2_SECRET_KEY
#   tenant "nutanix" -> LIBCLOUD_NTNX_USER / LIBCLOUD_NTNX_PASSWORD

# --- AWS tenant: aws --------------------------------------------------------
AWS_ACCESS_KEY=AKIAYHGEH2P75YEO4GGY
AWS_SECRET_ACCESS_KEY=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
