
 Dashboard 1 — Executive Overview (uid: nutanix-exec-overview)
                                                                                                                                                                                                              
  {                                                                                                                                                                                                         
    "uid": "nutanix-exec-overview",                                                                                                                                                                           
    "title": "Nutanix FinOps · Executive Overview",                                                                                                                                                         
    "style": "dark",                                                                                                                                                                                          
    "schemaVersion": 36,                                                                                                                                                                                    
    "refresh": "5m",
    "tags": ["nutanix", "finops", "executive"],                                                                                                                                                               
    "time": { "from": "now/M", "to": "now" },
    "panels": [                                                                                                                                                                                               
      { "id": 1,   "type": "stat",       "title": "MTD Spend",              "gridPos": {"h":5,"w":5,"x":0,"y":0},   "targets": [{"refId":"A","target":"api/finops/spend-summary/mtdSpend"}] },              
      { "id": 101, "type": "bargauge",   "title": "Month Progress",         "gridPos": {"h":5,"w":7,"x":5,"y":0},   "targets":                                                                                
  [{"refId":"A","target":"api/finops/spend-summary/monthProgressPct"},{"refId":"B","target":"api/finops/spend-summary/budgetUsedPct"}] },                                                                     
      { "id": 2,   "type": "stat",       "title": "EOM Forecast",           "gridPos": {"h":5,"w":4,"x":12,"y":0},  "targets": [{"refId":"A","target":"api/finops/spend-summary/forecastEOM"}] },             
      { "id": 3,   "type": "gauge",      "title": "Budget Consumed",        "gridPos": {"h":5,"w":4,"x":16,"y":0},  "targets": [{"refId":"A","target":"api/finops/spend-summary/budgetUsedPct"}] },           
      { "id": 4,   "type": "stat",       "title": "Savings Potential",      "gridPos": {"h":5,"w":4,"x":20,"y":0},  "targets": [{"refId":"A","target":"api/finops/spend-summary/savingsPotential"}] },        
      { "id": 102, "type": "stat",       "title": "Daily Run Rate",         "gridPos": {"h":3,"w":4,"x":0,"y":5},   "targets": [{"refId":"A","target":"api/finops/spend-summary/dailyRunRate"}] },            
      { "id": 103, "type": "stat",       "title": "vs Last Month",          "gridPos": {"h":3,"w":4,"x":4,"y":5},   "targets": [{"refId":"A","target":"api/finops/spend-summary/vsLastMonth"}] },             
      { "id": 104, "type": "stat",       "title": "Spend Pace",             "gridPos": {"h":3,"w":4,"x":8,"y":5},   "targets": [{"refId":"A","target":"api/finops/spend-summary/pacePct"}] },                 
      { "id": 5,   "type": "timeseries", "title": "12-Month Cost Trend",    "gridPos": {"h":8,"w":12,"x":12,"y":5}, "targets": [{"refId":"A","target":"api/finops/monthly-trend"}] },                         
      { "id": 6,   "type": "barchart",   "title": "Top Cost Drivers by Service",       "gridPos": {"h":10,"w":12,"x":0,"y":8},   "targets": [{"refId":"A","target":"api/finops/cost-by-service"}] },          
      { "id": 7,   "type": "piechart",   "title": "Savings Opportunity Breakdown",     "gridPos": {"h":10,"w":12,"x":12,"y":13}, "targets": [{"refId":"A","target":"api/finops/optimization-recommendations"}]
   },                                                                                                                                                                                                         
      { "id": 108, "type": "bargauge",   "title": "Budget Status by Cluster",          "gridPos": {"h":7,"w":12,"x":0,"y":18},  "targets": [{"refId":"A","target":"api/finops/cost-by-cluster"}] },           
      { "id": 109, "type": "table",      "title": "Cluster Cost Summary",              "gridPos": {"h":7,"w":12,"x":12,"y":23}, "targets":                                                                    
  [{"refId":"A","target":"api/finops/cost-by-cluster","type":"table"}] }                                                                                                                                      
    ]                                                                                                                                                                                                         
  }                                                                                                                                                                                                           
                  
  ---                                                                                                                                                                                                         
  Dashboard 2 — Service Cost Breakdown (uid: nutanix-cost-breakdown)
                                                                                                                                                                                                              
  {               
    "uid": "nutanix-cost-breakdown",
    "title": "Nutanix FinOps · Service Cost Breakdown",
    "style": "dark",                                                                                                                                                                                          
    "schemaVersion": 36,
    "refresh": "5m",                                                                                                                                                                                          
    "tags": ["nutanix", "finops", "cost"],
    "time": { "from": "now-90d", "to": "now" },                                                                                                                                                               
    "panels": [
      { "id": 1,   "type": "piechart",   "title": "Cost Distribution by Service Type",   "gridPos": {"h":12,"w":10,"x":0,"y":0},  "targets": [{"refId":"A","target":"api/finops/cost-by-service"}] },         
      { "id": 2,   "type": "piechart",   "title": "Cost by Environment",                 "gridPos": {"h":12,"w":7,"x":10,"y":0},  "targets": [{"refId":"A","target":"api/finops/environment-allocation"}] },  
      { "id": 201, "type": "bargauge",   "title": "Top Services — Spend Ranking",        "gridPos": {"h":12,"w":7,"x":17,"y":0},  "targets": [{"refId":"A","target":"api/finops/cost-by-service"}] },         
      { "id": 3,   "type": "timeseries", "title": "90-Day Daily Cost Trend",             "gridPos": {"h":9,"w":24,"x":0,"y":12}, "targets": [{"refId":"A","target":"api/finops/cost-90day-trend"}] },         
      { "id": 4,   "type": "table",      "title": "Resource Category Cost Table",        "gridPos": {"h":11,"w":24,"x":0,"y":21}, "targets":                                                                  
  [{"refId":"A","target":"api/finops/cost-by-service","type":"table"}] },                                                                                                                                     
      { "id": 5,   "type": "barchart",   "title": "Cost by Cluster",                     "gridPos": {"h":9,"w":24,"x":0,"y":32}, "targets": [{"refId":"A","target":"api/finops/cost-by-cluster"}] }           
    ]                                                                                                                                                                                                         
  }               
                                                                                                                                                                                                              
  ---             
  Dashboard 3 — Optimization & Recommendations (uid: nutanix-optimization)

  {
    "uid": "nutanix-optimization",                                                                                                                                                                            
    "title": "Nutanix FinOps · Optimization & Recommendations",
    "style": "dark",                                                                                                                                                                                          
    "schemaVersion": 36,
    "refresh": "10m",
    "tags": ["nutanix", "finops", "optimization"],                                                                                                                                                            
    "time": { "from": "now-30d", "to": "now" },
    "panels": [                                                                                                                                                                                               
      { "id": 1,   "type": "stat",     "title": "Rightsizing Savings",       "gridPos": {"h":5,"w":5,"x":0,"y":0},  "targets":
  [{"refId":"A","target":"api/finops/optimization-recommendations/rightsizingSavings"}] },                                                                                                                    
      { "id": 2,   "type": "stat",     "title": "Idle Waste",                "gridPos": {"h":5,"w":5,"x":5,"y":0},  "targets": [{"refId":"A","target":"api/finops/idle-resources/totalIdleWaste"}] },
      { "id": 3,   "type": "stat",     "title": "Storage Tiering Savings",   "gridPos": {"h":5,"w":5,"x":10,"y":0}, "targets":                                                                                
  [{"refId":"A","target":"api/finops/optimization-recommendations/storageTieringSavings"}] },                                                                                                                 
      { "id": 4,   "type": "stat",     "title": "Total Annual Potential",    "gridPos": {"h":5,"w":5,"x":15,"y":0}, "targets": [{"refId":"A","target":"api/finops/optimization-recommendations/totalAnnual"}] 
  },                                                                                                                                                                                                          
      { "id": 5,   "type": "gauge",    "title": "Utilization Efficiency",    "gridPos": {"h":5,"w":4,"x":20,"y":0}, "targets":
  [{"refId":"A","target":"api/finops/optimization-recommendations/utilizationEfficiencyPct"}] },                                                                                                              
      { "id": 6,   "type": "piechart", "title": "Savings by Category",       "gridPos": {"h":11,"w":8,"x":0,"y":5}, "targets": [{"refId":"A","target":"api/finops/optimization-recommendations"}] },
      { "id": 301, "type": "bargauge", "title": "Idle Resource Counts",      "gridPos": {"h":11,"w":8,"x":8,"y":5}, "targets":                                                                                
  [{"refId":"A","target":"api/finops/idle-resources/totalIdleVMs"},{"refId":"B","target":"api/finops/idle-resources/totalIdleVolumes"},{"refId":"C","target":"api/finops/idle-resources/totalStaleSnapshots"}]
   },                                                                                                                                                                                                         
      { "id": 302, "type": "bargauge", "title": "Cluster Utilization Overview","gridPos":{"h":11,"w":8,"x":16,"y":5},"targets": [{"refId":"A","target":"api/finops/cost-by-cluster"}] },                      
      { "id": 10,  "type": "table",    "title": "Optimization Recommendations","gridPos":{"h":16,"w":24,"x":0,"y":16},"targets":                                                                              
  [{"refId":"A","target":"api/finops/optimization-recommendations","type":"table"}] }                                                                                                                         
    ]                                                                                                                                                                                                         
  }                                                                                                                                                                                                           
                  
  ---
  Dashboard 4 — Anomaly Detection & Alerts (uid: nutanix-anomalies)
                                                                                                                                                                                                              
  {
    "uid": "nutanix-anomalies",                                                                                                                                                                               
    "title": "Nutanix FinOps · Anomaly Detection & Alerts",
    "style": "dark",
    "schemaVersion": 36,                                                                                                                                                                                      
    "refresh": "1m",
    "tags": ["nutanix", "finops", "anomalies", "alerts"],                                                                                                                                                     
    "time": { "from": "now-30d", "to": "now" },
    "panels": [                                                                                                                                                                                               
      { "id": 1, "type": "stat",       "title": "Open Anomalies",           "gridPos": {"h":5,"w":6,"x":0,"y":0},   "targets": [{"refId":"A","target":"api/finops/anomaly-events/openAnomalies"}] },
      { "id": 2, "type": "stat",       "title": "Critical / High Severity", "gridPos": {"h":5,"w":6,"x":6,"y":0},   "targets": [{"refId":"A","target":"api/finops/anomaly-events/highSeverity"}] },           
      { "id": 3, "type": "stat",       "title": "Over-Budget Entities",     "gridPos": {"h":5,"w":6,"x":12,"y":0},  "targets": [{"refId":"A","target":"api/finops/anomaly-events/overBudgetEntities"}] },     
      { "id": 4, "type": "stat",       "title": "Resolved This Week",       "gridPos": {"h":5,"w":6,"x":18,"y":0},  "targets": [{"refId":"A","target":"api/finops/anomaly-events/resolvedThisWeek"}] },       
      { "id": 5, "type": "timeseries", "title": "Cost Anomaly Baseline — 90-Day Trend", "gridPos": {"h":9,"w":24,"x":0,"y":5},  "targets": [{"refId":"A","target":"api/finops/cost-90day-trend"}] },          
      { "id": 6, "type": "table",      "title": "Anomaly Event Log",        "gridPos": {"h":16,"w":17,"x":0,"y":14}, "targets": [{"refId":"A","target":"api/finops/anomaly-events","type":"table"}] },        
      { "id": 7, "type": "table",      "title": "Budget Threshold Status",  "gridPos": {"h":16,"w":7,"x":17,"y":14}, "targets": [{"refId":"A","target":"api/finops/budget-thresholds","type":"table"}] }      
    ]                                                                                                                                                                                                         
  }                                                                                                                                                                                                           
                                                 
