# Frontend environment configuration.
# Copy to `.env` (or `.env.local`) and fill in real values. Variables MUST be
# prefixed with REACT_APP_ to be exposed to the browser bundle by CRA.
#
# NOTE: Never put provider client secrets here. The browser only needs the
# public client id + Dex issuer URL; the secret exchange happens backend-side
# in /api/auth/exchange.
#
# All externally-reachable URLs (Dex, identity service, portal callback) are
# derived from PUBLIC_HOSTNAME. To migrate to a different server, change this
# one value + update DNS (or /etc/hosts). Override individual REACT_APP_* vars
# for non-standard setups.

# Public hostname of this deployment. Drives all browser-facing URLs below.
# For local development, leave unset (defaults to localhost URLs below).
# PUBLIC_HOSTNAME=login.cloudweave.xyz

# Base URL of the Dex issuer (OIDC). Derived from PUBLIC_HOSTNAME or defaults
# to localhost for local development.
# REACT_APP_DEX_BASE_URL=http://localhost:5556/dex

# OAuth client id registered in Dex for this portal.
REACT_APP_DEX_CLIENT_ID=libcloud-portal

# OAuth redirect URI registered in Dex. Derived from PUBLIC_HOSTNAME or
# defaults to localhost for local development.
# REACT_APP_DEX_REDIRECT_URI=http://localhost:3000/auth/callback

# Base URL of the backend identity/portal API (the "identity service").
# Derived from PUBLIC_HOSTNAME or defaults to localhost for local development.
# REACT_APP_API_BASE_URL=http://localhost:8766

# When "true", the UI uses in-memory mock data instead of calling the backend.
# Useful for demos / local development without Dex or the identity service.
REACT_APP_MOCK_MODE=true

# When "true", hides Google/GitHub sign-in buttons (air-gapped deployments).
# Default true — only LLDAP login is shown; set to "false" when federation is
# configured and Dex can reach external OAuth2 providers.
# REACT_APP_DISABLE_FEDERATION=true

# Optional: override the post-login home route per role (defaults handled in code).
# REACT_APP_ROLE_HOME_VIEWER=/viewer
