# Identity service (portal backend) configuration.
# Values are sourced from the already-running stack:
#   - dex/generated/dex.env   (DEX_PORTAL_CLIENT_SECRET, DEX_* URLs)
#   - openfga_postgres/generated/fga.env  (FGA_API_URL, FGA_STORE_ID, FGA_MODEL_ID)
#   - lldap/.env              (LLDAP_LDAP_BASE_DN, LLDAP_LDAP_USER_PASS, LLDAP_ADMIN_USER)
# In docker-compose these are loaded via env_file, so you usually don't edit this.

# --- Dex (OIDC issuer) -------------------------------------------------------
# DEX_BASE_URL is set by docker-compose from PUBLIC_HOSTNAME (browser-facing).
# DEX_ISSUER is the in-container URL — all services reach Dex at dex:5556.
DEX_BASE_URL=http://dex:5556/dex
DEX_TOKEN_URL=http://dex:5556/dex/token
DEX_JWKS_URL=http://dex:5556/dex/keys
DEX_ISSUER=http://dex:5556/dex
DEX_PORTAL_CLIENT_ID=libcloud-portal
DEX_PORTAL_CLIENT_SECRET=change-me
# DEX_PORTAL_REDIRECT_URI is set by dex_bootstrap.py in ../dex/generated/dex.env
# (derived from PUBLIC_HOSTNAME). The value below is a fallback for local dev.
DEX_PORTAL_REDIRECT_URI=http://localhost:3000/auth/callback

# --- OpenFGA (authorization) -------------------------------------------------
FGA_ENABLED=true
FGA_API_URL=http://openfga:8081
FGA_STORE_ID=
FGA_MODEL_ID=
# The tenant objects that carry the role relations (see openfga_bootstrap.py).
FGA_AWS_TENANT=tenant:aws
FGA_NTNX_TENANT=tenant:nutanix

# --- LLDAP (internal user directory) ----------------------------------------
LLDAP_HOST=lldap
LLDAP_PORT=3890
LLDAP_USE_SSL=false
LLDAP_BIND_DN=uid=admin,ou=people,dc=libcloud,dc=local
LLDAP_BIND_PW=change-me
LLDAP_BASE_DN=ou=people,dc=libcloud,dc=local

# --- libcloud REST API (cloud orchestration) --------------------------------
LIBCLOUD_REST_URL=http://libcloud-rest-api:8765

# --- Session cookie ----------------------------------------------------------
# Secret used to sign the httpOnly session JWT. Generate with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=libcloud_portal_sid
SESSION_TTL_SECONDS=28800
SESSION_SECURE=false
SESSION_SAMESITE=lax

# --- Server ------------------------------------------------------------------
IDENTITY_PORT=8766
