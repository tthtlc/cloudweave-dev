# ─────────────────────────────────────────────────────────────────────────────
# Host-port overrides for the Nutanix IAM mock stack (docker-compose.yml).
# Copy this file to `.env` in this directory and edit, or export the variables
# before running `docker compose up`. Docker Compose reads `.env` automatically.
#
# Defaults (used when a variable is unset):
#   IAM_V40_PORT    = 9550
#   IAM_V41_B2_PORT = 9551
#   IAM_V41_B3_PORT = 9552
# ─────────────────────────────────────────────────────────────────────────────
IAM_V40_PORT=9550
IAM_V41_B2_PORT=9551
IAM_V41_B3_PORT=9552
