# ---------------------------------------------------------------------------
# OpenFGA — Postgres-backed deployment (supersedes the removed openfga_my
# SQLite deployment). Consolidates redesign_openfga_for_postgresql.md +
# adding_postgres_openfga.md.
# ---------------------------------------------------------------------------

# PostgreSQL datastore for OpenFGA.
#
# These credentials are used by the `postgres`, `openfga-migrate`, and `openfga`
# compose services. POSTGRES_HOST is the in-network container DNS name (do not
# change unless you point OpenFGA at an external managed Postgres — in which
# case drop the `postgres` service from docker-compose.yml and set POSTGRES_HOST
# + sslmode accordingly). For dev we use sslmode=disable; for production use
# sslmode=verify-full and mount a CA cert into the openfga container.
POSTGRES_HOST=postgres
POSTGRES_DB=openfga
POSTGRES_USER=openfga
# Generate a strong password for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# setup.sh auto-generates POSTGRES_PASSWORD into generated/postgres.env when
# this is left blank, and reuses it across re-runs so the data volume stays
# usable.
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
# Host port published only for local debugging (psql / pg_dump). Set to an empty
# value to avoid publishing 5432 at all in production.
PG_HOST_PORT=5433

# OpenFGA server image (built from ./Dockerfile). The Dockerfile is multi-stage:
# it downloads the official release tarball from GitHub and verifies it against
# OPENFGA_TARBALL_SHA256, so no openfga binary is vendored here. Bump both
# values together to upgrade — the checksum is for
#   openfga_<version-no-v>_linux_amd64.tar.gz
# (find it in the release's checksums.txt at
#  https://github.com/openfga/openfga/releases). setup.sh rebuilds the image
# automatically when either value changes.
#
# Why >= v1.16.0: OpenFGA's OIDC authenticator enables
# `RefreshUnknownKID: true` (rate-limited to 1/min) on the keyfunc JWKS cache,
# so it refetches Dex's JWKS when a token arrives with a `kid` not in cache —
# i.e. it adapts to Dex's 6h signing-key rotation without a container restart
# (the suggestion.md "dynamically pull keys" best practice). This fix is PR
# #3101 (https://github.com/openfga/openfga/pull/3101), merged 2026-05-14 and
# first released in v1.16.0.
#
# IMPORTANT: the previous comment here claimed ">= v1.8.8 sets
# RefreshUnknownKID: true". That was wrong. v1.8.x (including v1.8.16) leaves
# `RefreshUnknownKID` unset (default false), so on an unknown `kid` keyfunc
# returns ErrKIDNotFound and every `Check` fails with `invalid_claims` until
# the container is restarted — the recurring 6h `authz_fga_error` (503) we
# observed at portal login. v1.8.16 (built 2025-06-17) predates PR #3101 by
# ~11 months and never received a backport.
#
# v1.16.0 also bumps the Go toolchain to 1.26.3 and may include datastore
# migrations beyond the 1.8.x set, so `openfga-migrate` (run automatically by
# docker-compose before `openfga` starts) must be allowed to complete. Do not
# skip migrations.
OPENFGA_VERSION=v1.16.0
OPENFGA_TARBALL_SHA256=42b57295b86dec665e43b529f472615ccf4e5945c026c514fdb26bac697a8052

# Dex OIDC issuer — users live in LLDAP (../lldap); Dex authenticates over LDAP.
DEX_HTTP_PORT=5556
# Host-reachable Dex URL for browser flow / token endpoint. Used by host-side
# scripts (idp_login.py, verify_superadmin_jwt.py) and written by
# dex_bootstrap.py into ../dex/generated/dex.env as DEX_URL. The canonical
# issuer (Dex's `iss` claim, OpenFGA's --authn-oidc-issuer, and the federated
# connector callback base) is derived from DEX_PUBLIC_URL by dex_bootstrap.py
# as <DEX_PUBLIC_URL>/dex. setup.sh defaults DEX_PUBLIC_URL to
# http://login.quest4science.xyz:5556 if unset, but setting it explicitly
# here is strongly recommended — a changed issuer invalidates all outstanding
# Dex-issued JWTs and breaks OpenFGA token validation. See dex_bootstrap.py
# main() for details. Uncomment and set to your deployment's public URL.
# DEX_PUBLIC_URL=http://localhost:5556

# OpenFGA HTTP/gRPC/metrics. This stack owns the `openfga` container name and
# host ports 8080/8081/2112 — setup.sh removes any stale containers holding
# those names (e.g. leftovers from the removed openfga_my project) before up.
FGA_HTTP_PORT=8080
FGA_GRPC_PORT=8081
FGA_METRICS_PORT=2112
FGA_API_URL=http://localhost:8080
FGA_STORE_NAME=libcloud-rest-store
# OpenFGA OIDC authentication (reuses Dex). The defaults below match the
# canonical in-container issuer (http://dex:5556/dex) and the libcloud-rest
# audience. Set OPENFGA_AUTHN_METHOD=none to disable authn for debugging.
# See authorization.md §15.3 for the issuer topology.
OPENFGA_AUTHN_METHOD=oidc
OPENFGA_AUTHN_OIDC_ISSUER=http://dex:5556/dex
OPENFGA_AUTHN_OIDC_AUDIENCE=libcloud-rest

# libcloud REST API (host-side scripts reach this URL)
LIBCLOUD_REST_URL=http://localhost:8765
LIBCLOUD_OIDC_CLIENT_ID=libcloud-rest
LIBCLOUD_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Phase-2: role portal (../server) OAuth client + federated connectors.
# ---------------------------------------------------------------------------
# Consumed by dex_bootstrap.py (openfga_postgres/dex_bootstrap.py) to render
# the `libcloud-portal` staticClient and the google/github connectors in
# dex/config.yaml. These MUST be persisted here (not just in
# dex/generated/dex.env) because setup.sh's first dex_bootstrap.py call
# rewrites dex.env from the shell env (sourced from this .env) BEFORE the
# old dex.env is sourced — so if these are absent here, every setup.sh
# re-run silently drops the portal client + federated connectors, and
# portal login fails with "Invalid client_id (\"libcloud-portal\")" at Dex.
#
# Generate fresh secrets for production with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave DEX_PORTAL_REDIRECT_URI empty for an LLDAP-only stack (no portal).
DEX_PORTAL_CLIENT_ID=libcloud-portal
DEX_PORTAL_CLIENT_SECRET=
DEX_PORTAL_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional federated upstream connectors for the portal's "Sign in with
# Google/GitHub" buttons. The LDAP connector (lldap) stays the primary
# directory for libcloud-rest + OpenFGA. Leave empty to disable.
DEX_GOOGLE_CLIENT_ID=
DEX_GOOGLE_CLIENT_SECRET=
DEX_GITHUB_CLIENT_ID=
DEX_GITHUB_CLIENT_SECRET=

# superadmin (LLDAP uid=superadmin) — the bootstrap identity.
# After a successful Dex login as superadmin, the resulting JWT gates:
#   - Vault seeding of backend cloud credentials
#   - OpenFGA policy / privilege tuple changes
#   - LLDAP user create / modify / delete
# Leave blank to let setup.sh generate a password into generated/dex.env.
LIBCLOUD_SUPERADMIN_PASSWORD=

# Per-cloud tenant users (LLDAP). Passwords are generated by setup.sh into
# generated/dex.env when the values below are blank.
ALLOW_DEV_DEFAULTS=1
LIBCLOUD_PASSWORD_AWS_OWNER=
LIBCLOUD_PASSWORD_AWS_ADMIN=
LIBCLOUD_PASSWORD_AWS_VIEWER=
LIBCLOUD_PASSWORD_NTNX_OWNER=
LIBCLOUD_PASSWORD_NTNX_ADMIN=
LIBCLOUD_PASSWORD_NTNX_VIEWER=
# Authenticated but unauthorized demo user (no OpenFGA tuples -> denied).
LIBCLOUD_PASSWORD_CLOUD_DENIED=CloudDenied123!

# Vault (encrypted secret store for backend cloud credentials)
VAULT_PORT=8200
VAULT_PUBLIC_ADDR=http://localhost:8200
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=libcloud

# Backend cloud credentials are NOT stored in this file and are NOT seeded
# globally. Each tenant's credentials live in Vault at:
#   secret/data/libcloud/aws       (tenant:aws  -> AWS key/secret)
#   secret/data/libcloud/nutanix   (tenant:nutanix -> Nutanix user/password)
# They are written by the tenant OWNER only (OpenFGA can_manage_credentials),
# via scripts/set_tenant_credentials.py, e.g.:
#   TENANT=aws LIBCLOUD_USER=aws-owner LIBCLOUD_PASSWORD=... \
#     LIBCLOUD_AWS_KEY=AKIA... LIBCLOUD_AWS_SECRET=... \
#     python3 scripts/set_tenant_credentials.py
#   TENANT=nutanix LIBCLOUD_USER=ntnx-owner LIBCLOUD_PASSWORD=... \
#     LIBCLOUD_NTNX_USER=admin LIBCLOUD_NTNX_PASSWORD=... \
#     python3 scripts/set_tenant_credentials.py
# superadmin (owner on both tenants) can also set them. admins/viewers cannot.

# Provider connection selectors sent by client scripts (no secrets). The
# binding maps to the per-tenant Vault path secret/data/libcloud/<binding>.
LIBCLOUD_AWS_AUTH_BINDING=aws
LIBCLOUD_NTNX_AUTH_BINDING=nutanix
AWS_REGION=ap-southeast-1
AWS_IMAGE_NAME_FILTER=*ubuntu*24.04*amd64*
AWS_INSTANCE_ARCH=x86_64
AWS_DEFAULT_SIZE_ID=t3.micro
NUTANIX_HOST=host.docker.internal
NUTANIX_PORT=9440
NUTANIX_API_VERSION=v4.0
NUTANIX_VERIFY_SSL=false
