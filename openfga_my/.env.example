# Dex OIDC issuer — users live in LLDAP (../lldap); Dex authenticates over LDAP.
DEX_HTTP_PORT=5556
DEX_URL=http://localhost:5556

# OpenFGA (persistent sqlite datastore on the openfga-data volume)
FGA_HTTP_PORT=8080
FGA_GRPC_PORT=8081
FGA_METRICS_PORT=2112
FGA_API_URL=http://localhost:8080
FGA_STORE_NAME=libcloud-rest-store
# OpenFGA OIDC authentication (reuses Dex). The defaults below match the
# canonical in-container issuer (http://dex:5556/dex) and the libcloud-rest
# audience. Set OPENFGA_AUTHN_METHOD=none to disable authn for debugging.
# See authorization.md §15.3 for the issuer topology.
OPENFGA_AUTHN_METHOD=oidc
OPENFGA_AUTHN_OIDC_ISSUER=http://dex:5556/dex
OPENFGA_AUTHN_OIDC_AUDIENCE=libcloud-rest

# libcloud REST API (host-side scripts reach this URL)
LIBCLOUD_REST_URL=http://localhost:8765
LIBCLOUD_OIDC_CLIENT_ID=libcloud-rest
LIBCLOUD_OIDC_CLIENT_SECRET=

# IdP selection for scripts/idp_login.py (LLDAP-backed Dex only).
IDP_PROVIDER=dex

# superadmin (LLDAP uid=superadmin) — the bootstrap identity.
# After a successful Dex login as superadmin, the resulting JWT gates:
#   - Vault seeding of backend cloud credentials
#   - OpenFGA policy / privilege tuple changes
#   - LLDAP user create / modify / delete
# Leave blank to let setup.sh generate a password into generated/dex.env.
LIBCLOUD_SUPERADMIN_PASSWORD=

# Per-cloud tenant users (LLDAP). Passwords are generated by setup.sh into
# generated/dex.env when the values below are blank.
ALLOW_DEV_DEFAULTS=1
LIBCLOUD_PASSWORD_AWS_OWNER=
LIBCLOUD_PASSWORD_AWS_ADMIN=
LIBCLOUD_PASSWORD_AWS_VIEWER=
LIBCLOUD_PASSWORD_NTNX_OWNER=
LIBCLOUD_PASSWORD_NTNX_ADMIN=
LIBCLOUD_PASSWORD_NTNX_VIEWER=
# Authenticated but unauthorized demo user (no OpenFGA tuples -> denied).
LIBCLOUD_PASSWORD_CLOUD_DENIED=CloudDenied123!

# Vault (encrypted secret store for backend cloud credentials)
VAULT_PORT=8200
VAULT_PUBLIC_ADDR=http://localhost:8200
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=libcloud

# Backend cloud credentials are NOT stored in this file and are NOT seeded
# globally. Each tenant's credentials live in Vault at:
#   secret/data/libcloud/aws       (tenant:aws  -> AWS key/secret)
#   secret/data/libcloud/nutanix   (tenant:nutanix -> Nutanix user/password)
# They are written by the tenant OWNER only (OpenFGA can_manage_credentials),
# via scripts/set_tenant_credentials.py, e.g.:
#   TENANT=aws LIBCLOUD_USER=aws-owner LIBCLOUD_PASSWORD=... \
#     LIBCLOUD_AWS_KEY=AKIA... LIBCLOUD_AWS_SECRET=... \
#     python3 scripts/set_tenant_credentials.py
#   TENANT=nutanix LIBCLOUD_USER=ntnx-owner LIBCLOUD_PASSWORD=... \
#     LIBCLOUD_NTNX_USER=admin LIBCLOUD_NTNX_PASSWORD=... \
#     python3 scripts/set_tenant_credentials.py
# superadmin (owner on both tenants) can also set them. admins/viewers cannot.

# Provider connection selectors sent by client scripts (no secrets). The
# binding maps to the per-tenant Vault path secret/data/libcloud/<binding>.
LIBCLOUD_AWS_AUTH_BINDING=aws
LIBCLOUD_NTNX_AUTH_BINDING=nutanix
AWS_REGION=ap-southeast-1
AWS_IMAGE_NAME_FILTER=*Ubuntu*
AWS_INSTANCE_ARCH=x86_64
AWS_DEFAULT_SIZE_ID=t3.micro

# Set TEARDOWN_VMS=1 to delete the libcloud-demo-* / libcloud-ntnx-* VM created
# by the provision scripts at the end of their provision section (PROVISION=1).
TEARDOWN_VMS=0
NUTANIX_HOST=host.docker.internal
NUTANIX_PORT=9440
NUTANIX_API_VERSION=v4.0
NUTANIX_VERIFY_SSL=false
