# Example/template for my.env (the live-reloadable runtime config).
# Copy to my.env and adjust. See my.env for full documentation of each value.
#
# PUBLIC_HOSTNAME: browser-facing hostname; still requires a portal+dex recreate
# after change (baked into the JS bundle + Dex redirect URIs).
PUBLIC_HOSTNAME=your-hostname.example.com
# NUTANIX_*: Prism Central endpoint; these take effect on the NEXT request with
# no container restart.
NUTANIX_HOST=host.docker.internal
NUTANIX_PORT=9440
NUTANIX_API_VERSION=v4.0
NUTANIX_VERIFY_SSL=false
