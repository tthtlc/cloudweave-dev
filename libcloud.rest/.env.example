# Docker
API_PORT=8765

# API signing
JWT_SIGNING_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
API_ISSUER=libcloud-rest
API_AUDIENCE=libcloud-rest-api

# Authentication: OIDC only. Users live in LLDAP and authenticate via Dex
# (OIDC). The REST API does NOT maintain a local/static user directory and
# never auto-creates an admin user. Local password login (/v1/auth/login) is
# disabled in oidc mode. Set AUTH_MODE=hybrid only for local dev with a
# manually-managed data/users.json.
AUTH_MODE=oidc

# ----------------------------------------------------------------------------
# Server-side backend identity (the API's OWN cloud identity).
#
# Security design (rest_api_security.md): the client authenticates to the API
# with OIDC/OAuth2 and the API reaches the cloud backend using ITS OWN identity
# (IAM role / service account). The client NEVER receives or passes backend
# credentials. In production, prefer the compute platform default credential
# chain (ECS task role / EKS IRSA / EC2 instance profile) and leave the long-lived
# keys below empty. The keys here are a fallback for local/dev single-host setups
# when Vault is not configured.
# ----------------------------------------------------------------------------
# Reject client-supplied `credentials` on connection objects. Set to true ONLY
# for local dev where the API has no backend identity of its own.
ALLOW_CLIENT_CREDENTIALS=false

# Vault secret broker (preferred). When VAULT_ADDR + VAULT_TOKEN are set, the
# API reads backend credentials from KV v2 at {VAULT_KV_MOUNT}/data/{VAULT_KV_PREFIX}/<binding>
# (e.g. secret/data/libcloud/aws) — one secret per tenant. The auth_binding
# (tenant id) selects both the Vault secret and the OpenFGA backend object.
# See ../openfga_my/authorization.md.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=libcloud

# Plaintext fallback (used ONLY when VAULT_ADDR/VAULT_TOKEN are empty). Prefer
# Vault; leave these blank in any deployment that runs Vault.
LIBCLOUD_AWS_PROD_KEY=
LIBCLOUD_AWS_PROD_SECRET=
LIBCLOUD_NTNX_LAB_USER=
LIBCLOUD_NTNX_LAB_PASSWORD=

NUTANIX_HOST=host.docker.internal
NUTANIX_PORT=9440
NUTANIX_API_VERSION=v4.0
NUTANIX_VERIFY_SSL=false
AWS_DEFAULT_REGION=ap-southeast-1

# Storage paths
USERS_FILE=data/users.json

# Authentication mode: local | oidc | hybrid (see AUTH_MODE above)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=libcloud-rest
OIDC_TENANT_ID=default

# OpenFGA authorization (optional; enable after running ../openfga_my/setup.sh)
FGA_ENABLED=false
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_API_OBJECT=libcloud_api:main
# Per-tenant model: backend object id = auth_binding (tenant id). Fallbacks
# when a client omits auth_binding; map to seeded tenant:aws / tenant:nutanix.
FGA_NUTANIX_CLUSTER=nutanix
FGA_AWS_REGION_OBJECT=aws

# AWS image catalog default (DescribeImages name filter; use name=* query param to disable)
AWS_DEFAULT_IMAGE_NAME_FILTER=*Ubuntu*
